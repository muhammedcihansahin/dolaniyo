{
  "name": "yilan-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Yılan.io — tarayıcıda oynanan çok oyunculu yılan oyunu",
  "workspaces": [
    "packages/shared",
    "packages/client",
    "packages/server"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,yellow \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev -w @yilan/client",
    "dev:server": "npm run dev -w @yilan/server",
    "build": "npm run build -w @yilan/client",
    "start": "npm run start -w @yilan/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w @yilan/shared && npm run typecheck -w @yilan/client && npm run typecheck -w @yilan/server",
    "format": "prettier --write .",
    "bench": "tsx tools/simbench.ts"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
